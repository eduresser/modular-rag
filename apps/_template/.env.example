# The secret VALUES this client's config.yaml names. Every one of them, because
# `env:` is the only backend a reference may name. Copy to apps/<client>/.env,
# which is never committed; in production the same names are the platform's own
# variables.

# The service account's key, as ONE line of JSON. The private key's newlines
# are already `\n` escapes inside it, so the whole document fits on a line, and
# single quotes are what carry it through `set -a; . apps/<client>/.env`.
#   jq -c . < path/to/service-account.json
#
# THREE sections of config.yaml point at this one variable — `source`, `read`
# and `chunk` — because one key opens the Drive folder, the Layout Parser and
# the artifact bucket, each at its own narrow scope. That is three references
# to one value, never three values: a stage states the credential it spends so
# that a module arriving with a key of its own has somewhere to name it, and
# until one does they all resolve here.
GOOGLE_SERVICE_ACCOUNT_KEY=''

# The embedding gateway's key.
OPENROUTER_KEY=''

# The credential the conventional routes and the tool surface accept.
API_TOKEN=''

# Local database value, when config.yaml names db.url_secret: env:DATABASE_URL.
# Omit this assignment until switching to url_secret (an empty value is not a connection).
# DATABASE_URL='postgresql://postgres@127.0.0.1:5433/postgres'
