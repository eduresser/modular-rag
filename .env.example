# The complete catalogue of what this service reads from the environment.
#
# It is short, and that is the point: since config-yaml, the environment
# configures NOTHING. A deployment's settings live in one committed file —
# `apps/<app>/config.yaml`, read over `apps/base/config.yaml` — so "how is this
# client configured" has one answer, in version control, reviewable before a
# run rather than reconstructed from a dashboard after one.
#
# What is left here is four kinds of variable:
#
#   1. which deployment this is;
#   2. the secret VALUES a deployment's file points at by reference;
#   3. knobs the Makefile takes.
#
# There are no `RAG_*` settings any more. A variable named after one configures
# nothing and is not consulted — `tests/test_spec_config_yaml.py::test_ac_169`
# proves it over the whole configuration, not one field.
#
# This file is a catalogue, not a file to copy. Copy
# `apps/_template/.env.example` to `apps/<app>/.env` for the secrets, which is
# where a deployment's own `.env` belongs and what the Makefile sources.
# `tests/test_committed_deployments.py` asserts that every variable the build
# can read is named below, so this cannot quietly fall behind the code.


# ── 1. Which deployment this is ───────────────────────────────────────────
#
# A name, never a path: `apps/<app>/config.yaml` follows from it, which removes
# the way to point at the wrong file. Unprefixed on purpose — a collision
# resolves to `apps/<junk>/config.yaml` and fails loudly by name, so it can
# never be read as a setting of ours.
#
# There is no default. `apps/base/config.yaml` is the layer clients overlay and
# would not validate alone, so a missing name is an error that lists the
# deployments in the build.
#
# Usually passed per command (`make enumerate APP=example`) rather than set here.
APP=

# NOT a variable you set: RAG_CONFIG named a path in one commit before `APP`
# replaced it, and it is now REFUSED rather than ignored — a stale path
# quietly beating the app that was asked for is the failure that guard exists
# to prevent. Unset it if a shell still exports it.


# ── 2. The secret values a deployment references ──────────────────────────
#
# These belong in `apps/<app>/.env`, which is never committed. They are listed
# here because the list is real and an operator needs it — but a value pasted
# into this file would be a credential in version control, so leave them empty.
#
# A setting whose name ends in `_secret` carries a REFERENCE and never a value
# (principle P-012), and the reference names its backend. There is one:
#
#   env:NAME     the environment variable NAME holds the value.
#
# A reference naming anything else stops the boot listing what this build does
# resolve (AC-243). A secret manager was the second backend until
# env-only-secrets removed it: reading it needed a Google credential taken from
# this same environment, so the sealed path was never sealed end to end — it
# made one variable the only thing worth stealing instead of taking the count
# of unsealed values to zero. What it bought was rotation and an access log on
# the three credentials behind it, and that is the cost of this decision
# (ASM-133). The names below are the ones `apps/example/config.yaml` happens to
# reference — another client names whatever it likes, and this catalogue
# follows the committed files rather than prescribing to them.

# The Drive service account's key, as ONE line of JSON. The private key's
# newlines are already `\n` escapes inside it, so the whole document fits on a
# line, and single quotes are what carry it through `set -a; . apps/<app>/.env`.
#   jq -c . < path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=

# The embedding gateway's key.
OPENROUTER_KEY=

# The credential the conventional routes and the tool surface accept.
API_TOKEN=

# When db.url_secret names env:DATABASE_URL. The local value lives in apps/<app>/.env.
DATABASE_URL=


# ── 3. Knobs the Makefile takes ───────────────────────────────────────────
#
# Make variables, so the environment can override them. Usually passed per
# command; set here only to stop repeating yourself.

# Extra flags for a tool: make ingest APP=example ARGS="--yes --limit 3"
ARGS=

# Which mode `make embed` probes:
# request | call | providers | roles | batches | neighbours
MODE=

# Which port `make dev` binds the surface role to. 8080 is what the image
# exposes and what the platform's own $PORT usually is, so the default is the
# one production uses; it is a knob because 8080 is a popular port on a
# developer's machine and a failed bind is not the role's own fault.
PORT=8080

# What `make docker-build` tags the container it builds, and what
# `make docker-serve` and `make docker-worker` then run. A name and not a
# registry path: pushing it somewhere is the platform's business, and the two
# roles differ by the argument after the image, never by the image itself
# (ASM-093).
IMAGE=modular-rag

# The local pgvector `make db-up` starts, and the port it publishes. The port
# has to match the `db.url` in the deployment's configuration.
PG_CONTAINER=rag-pg
PG_PORT=5433
